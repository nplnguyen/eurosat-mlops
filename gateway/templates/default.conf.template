# Passerelle unique du système (reverse proxy + canary deployment).
#
#   /api/*   -> API (répartition stable / canary)
#   /        -> interface Streamlit
#
# Canary : ${CANARY_WEIGHT}% des requêtes sont aiguillées vers api-canary
# (alias MLflow "challenger"). Le header `X-Canary: always|never` force le
# routage (utile pour les tests et la démo).

upstream api_stable { server api-stable:8000; keepalive 32; }
upstream api_canary { server api-canary:8000; keepalive 16; }
upstream ui         { server ui:8501; }

split_clients "$request_id" $canary_bucket {
    ${CANARY_WEIGHT}%  canary;
    *                  stable;
}

map $http_x_canary $api_track {
    "always"  canary;
    "never"   stable;
    default   $canary_bucket;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

limit_req_zone $binary_remote_addr zone=perip:10m rate=200r/s;

server {
    listen 80;
    server_name _;
    client_max_body_size 50m;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;

    # Les métriques internes ne sont jamais exposées publiquement
    location ~ ^/api/metrics { return 404; }

    location /api/ {
        limit_req zone=perip burst=400 nodelay;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://api_$api_track;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /api;
        add_header X-Gateway-Track $api_track always;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://ui;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }

    location = /gateway/health { return 200 "ok\n"; }
}
