# Copier en .env puis adapter (make env le fait avec des secrets aléatoires)
API_KEY_PEPPER=change-me-long-random-string
ADMIN_API_KEY=eus_admin-change-me
POSTGRES_PASSWORD=postgres
GRAFANA_PASSWORD=admin

# Déploiement
REGISTRY=local
IMAGE_TAG=latest
CANARY_WEIGHT=10
MODEL_VARIANT=int8
ORT_THREADS=2
GATEWAY_PORT=80
MLFLOW_PORT=5001

# Bootstrap (premier modèle entraîné automatiquement si le registre est vide)
BOOTSTRAP_EPOCHS=3
BOOTSTRAP_SUBSET=0.3
